# Database
DATABASE_URL="postgresql://user:password@localhost:5432/alumni_db?schema=public"

# App & Auth
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production"

# OTP Provider Configuration
# Options: "mock" (default for development), "msg91", "firebase"
OTP_PROVIDER="mock"
MOCK_OTP_CODE="123456"

# MSG91 Configuration (Optional - for production India SMS)
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""

# Firebase Phone Auth (Optional)
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Storage Provider (Optional - for event photos & profile avatars)
# Options: "local" (default for development), "s3", "r2"
STORAGE_PROVIDER="local"

# WhatsApp Cloud API (Optional - for future WhatsApp notifications)
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
