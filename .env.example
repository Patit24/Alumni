# Database
DATABASE_URL="postgresql://user:password@localhost:5432/alumni_db?schema=public"

# App & Auth
NEXT_PUBLIC_APP_URL="https://your-domain.com"
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production"

# SMS Carrier Gateway Options for Real SMS Delivery:
# 1. Fast2SMS (India DLT / OTP)
# FAST2SMS_API_KEY="your-fast2sms-api-key"

# 2. Twilio (Global SMS)
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_FROM_NUMBER="+1234567890"

# 3. MSG91 (India / International)
# MSG91_AUTH_KEY="your-msg91-auth-key"
# MSG91_TEMPLATE_ID="your-template-id"

# Supabase Realtime
NEXT_PUBLIC_SUPABASE_URL="https://xyz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
