// Prisma schema for Alumni Network

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Institution {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  type             String       @default("COLLEGE") // "COLLEGE", "SCHOOL", "UNIVERSITY"
  city             String?
  state            String?
  country          String       @default("India")
  logoUrl          String?
  isApproved       Boolean      @default(true)
  foundingMemberId String?

  departments      Department[]
  batches          Batch[]
  users            User[]
  jobs             Job[]
  events           Event[]
  feedItems        FeedItem[]
  groups           Group[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Department {
  id            String       @id @default(cuid())
  name          String
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users         User[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, name])
}

model Batch {
  id            String       @id @default(cuid())
  year          Int
  estimatedSize Int          @default(60) // Used for virality counter "X of ~Y joined"
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users         User[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, year])
}

model User {
  id                 String       @id @default(cuid())
  phone              String?      @unique
  email              String?      @unique
  username           String?      @unique
  name               String
  avatarUrl          String?
  coverUrl           String?
  bio                String?
  role               String       @default("USER") // "USER", "INSTITUTION_ADMIN", "SUPER_ADMIN"
  verificationStatus String       @default("UNVERIFIED") // "UNVERIFIED", "VERIFIED"
  verifiedAt         DateTime?
  verifiedById       String?

  institutionId      String
  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  course             String?      // e.g. "BCA", "B.Tech CSE"

  batchId            String
  batch              Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchYear          Int

  currentCompany     String?
  currentRole        String?
  city               String?
  linkedinUrl        String?

  // Mentorship
  isOpenToMentor     Boolean      @default(false)
  mentorTopics       String?      // Comma-separated or JSON list of topics (e.g. "resume,mock_interview")
  mentorScope        String       @default("INSTITUTION_ONLY") // "INSTITUTION_ONLY", "ALL"

  // Privacy toggles
  isPhoneVisible     Boolean      @default(false)
  isLinkedinVisible  Boolean      @default(true)

  // Relations
  sentMentorships     MentorshipRequest[]  @relation("SentMentorships")
  receivedMentorships MentorshipRequest[]  @relation("ReceivedMentorships")
  postedJobs          Job[]
  createdEvents       Event[]
  eventRsvps          EventRsvp[]
  eventPhotos         EventPhoto[]
  feedItems           FeedItem[]
  postLikes           PostLike[]
  postComments        PostComment[]
  postShares          PostShare[]
  createdGroups       Group[]              @relation("CreatedGroups")
  groupMemberships    GroupMember[]
  chatMessages        ChatMessage[]

  // Universal Community Engine Relations
  ownedCommunities        Community[]               @relation("OwnedCommunities")
  communityMemberships    CommunityMember[]
  communityInvitesCreated CommunityInvite[]
  communityJoinRequests   CommunityJoinRequest[]
  communityAnnouncements  CommunityAnnouncement[]
  communityEvents         CommunityEvent[]
  communityEventRsvps     CommunityEventRsvp[]
  communityPollVotes      CommunityPollVote[]
  communityChannelMessages CommunityChannelMessage[]

  // Vouches
  vouchesGiven        VerificationVouch[]   @relation("VouchesGiven")
  vouchesReceived     VerificationVouch[]   @relation("VouchesReceived")

  // E2EE Devices & Privacy
  devices             UserDevice[]
  privacySettings     UserPrivacySettings?

  // Connection Requests & Relationships
  sentConnectionRequests     ConnectionRequest[]   @relation("SentConnectionRequests")
  receivedConnectionRequests ConnectionRequest[]   @relation("ReceivedConnectionRequests")

  // In-App Notifications
  notifications              AppNotification[]     @relation("UserNotifications")
  actedNotifications         AppNotification[]     @relation("NotificationActor")

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model VerificationVouch {
  id           String   @id @default(cuid())
  confirmerId  String
  confirmer    User     @relation("VouchesGiven", fields: [confirmerId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("VouchesReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique([confirmerId, targetUserId])
}

model MentorshipRequest {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation("SentMentorships", fields: [senderId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User     @relation("ReceivedMentorships", fields: [mentorId], references: [id], onDelete: Cascade)

  topic     String   // "Resume Review", "Mock Interviews", "Career Switch", "Referrals", "Domain Guidance"
  message   String
  status    String   @default("PENDING") // "PENDING", "ACCEPTED", "DECLINED", "COMPLETED"
  helped    Boolean? // Post-session "this helped" trust mark

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id            String      @id @default(cuid())
  posterId      String
  poster        User        @relation(fields: [posterId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  title         String
  company       String
  location      String
  roleType      String      @default("FULL_TIME") // "FULL_TIME", "INTERNSHIP", "CONTRACT", "REMOTE"
  description   String
  applyUrl      String?
  visibility    String      @default("INSTITUTION_ONLY") // "INSTITUTION_ONLY", "ALL"

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Event {
  id            String       @id @default(cuid())
  creatorId     String
  creator       User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  title         String
  description   String
  date          DateTime
  location      String?
  batchScope    String       @default("ALL") // "ALL" or comma-separated years e.g. "2020,2021"
  coverPhoto    String?

  rsvps         EventRsvp[]
  photos        EventPhoto[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("CONFIRMED") // "CONFIRMED", "CANCELLED"

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model EventPhoto {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  url        String
  caption    String?

  createdAt  DateTime @default(now())
}

model FeedItem {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  type          String      // "USER_JOINED", "JOB_POSTED", "MENTORSHIP_REQUEST", "EVENT_CREATED", "ANNIVERSARY"
  targetId      String?
  metadata      String?     // Serialized JSON for rich context

  likes         PostLike[]
  comments      PostComment[]
  shares        PostShare[]

  createdAt     DateTime    @default(now())
}

model PostLike {
  id         String   @id @default(cuid())
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([feedItemId, userId])
  @@index([feedItemId])
}

model PostComment {
  id         String   @id @default(cuid())
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([feedItemId])
}

model PostShare {
  id         String   @id @default(cuid())
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String   @default("IN_APP") // "IN_APP", "LINK_COPY", "WHATSAPP"
  createdAt  DateTime @default(now())

  @@index([feedItemId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([phone])
}

model Group {
  id            String        @id @default(cuid())
  name          String
  description   String?
  avatar        String?
  scope         String        @default("SAME_BATCH") // "SAME_BATCH", "INSTITUTION"
  batchYear     Int?
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User          @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)

  // Secret Conversation & Privacy Controls
  isSecretMode    Boolean       @default(false)   // Only group members can view; 2-day auto vanish
  allowScreenshot Boolean       @default(false)   // Admin controls whether members can take screenshots

  members       GroupMember[]
  messages      ChatMessage[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // "ADMIN", "MEMBER"
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  type      String   @default("TEXT") // "TEXT", "MUSIC_SHARE", "SYSTEM"
  metadata  String?  // JSON for shared track info or player state

  createdAt DateTime @default(now())
}

// Cryptographic device registration for E2EE public keys
model UserDevice {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String    @unique
  deviceName   String    // e.g. "Safari on iPhone", "Chrome on Mac"
  publicKey    String    // SPKI Base64 representation of ECDH public key
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// Ephemeral encrypted message queue (Zero plaintext, auto-purged upon delivery or expiry)
model EncryptedMessageQueue {
  id                String    @id @default(cuid())
  senderId          String
  senderDeviceId    String
  recipientId       String
  recipientDeviceId String?
  encryptedPayload  String    // Ciphertext + IV + Auth tag (Base64 JSON)
  messageType       String    @default("TEXT") // "TEXT", "SIGNALING", "RECEIPT"
  createdAt         DateTime  @default(now())
  expiresAt         DateTime

  @@index([recipientId, expiresAt])
}

// User communication privacy settings
model UserPrivacySettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readReceipts            Boolean  @default(true)
  typingIndicators        Boolean  @default(true)
  onlineStatus            Boolean  @default(true)
  lastSeen                Boolean  @default(false)
  allowCallsFrom          String   @default("EVERYONE") // "EVERYONE", "VERIFIED_ONLY", "BATCH_ONLY"
  disappearingDefault     Int      @default(0) // 0 = off, seconds: 30, 60, 3600, 86400, 604800
  privacyLockActive       Boolean  @default(false) // Emergency Privacy Lock mode
  ghostNotifications      Boolean  @default(true) // Ghost Notifications ("New message", no preview)
  screenshotAlert         Boolean  @default(true) // Detect and alert on screenshot/recording events
  contactDiscoveryEnabled Boolean  @default(true) // Allow discovery via hashed contact matching
  presenceVisibility     String   @default("LIMITED") // "EVERYONE", "CONTACTS", "TRUSTED", "CHATTING_ONLY", "NOBODY"
  showInstitution         Boolean  @default(true) // Show my school/university on profile
  allowInstitutionDiscovery Boolean @default(true) // Show me to people from my institution in discovery
  showCourse              Boolean  @default(true) // Show course
  showGraduationYear      Boolean  @default(true) // Show graduation year
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Contact Trust Levels & Mutual Reveal Handshake
model ContactTrust {
  id                  String   @id @default(cuid())
  userId              String
  contactId           String
  trustLevel          String   @default("REQUEST") // "UNKNOWN", "REQUEST", "CONNECTED", "TRUSTED", "BLOCKED"
  revealedPhone       Boolean  @default(false)
  revealedEmail       Boolean  @default(false)
  revealedWork        Boolean  @default(false)
  verifiedFingerprint String?  // Verified 30-digit safety fingerprint
  verifiedAt          DateTime?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([userId, contactId])
  @@index([userId])
}

// Rotated Identity History (retired public discovery handles)
model RotatedUsername {
  id         String   @id @default(cuid())
  userId     String
  username   String   @unique
  rotatedAt  DateTime @default(now())

  @@index([userId])
}

// Blocked users
model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// User abuse report
model UserReport {
  id          String   @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      String
  createdAt   DateTime @default(now())
}

// User-to-User Connection Requests
model ConnectionRequest {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentConnectionRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedConnectionRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "CANCELLED", "BLOCKED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

// User in-app notifications
model AppNotification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type       String   // "CONNECTION_REQUEST", "CONNECTION_ACCEPTED", "MESSAGE", "COMMUNITY_INVITE", "SYSTEM"
  title      String
  body       String
  data       String?  // Serialized JSON metadata
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ==========================================
// UNIVERSAL COMMUNITY ENGINE MODELS
// ==========================================

model Community {
  id                      String                   @id @default(cuid())
  slug                    String?                  @unique
  name                    String
  description             String?
  avatarUrl               String?
  coverUrl                String?
  type                    String                   @default("CUSTOM") // EDUCATION, ORGANIZATION, SPORTS, GAMING, CLUB, NGO, EVENT, FRIENDS, PRIVATE, CUSTOM
  
  // Privacy & Governance Settings
  discoverability         String                   @default("MEMBERS_ONLY") // PUBLIC, INVITE_ONLY, MEMBERS_ONLY, HIDDEN
  joinMethod              String                   @default("INVITE_LINK")  // INVITE_ONLY, QR_CODE, INVITE_LINK, REQUEST_APPROVAL, CODE_PROTECTED
  joinCode                String?
  memberListVisibility    String                   @default("EVERYONE")     // EVERYONE, MEMBERS_ONLY, ADMINS_ONLY
  invitePermission        String                   @default("ALL_MEMBERS")  // OWNER_ONLY, ADMINS, SELECTED_ROLES, ALL_MEMBERS
  channelCreatePermission String                   @default("ADMINS")       // OWNER_ONLY, ADMINS, SELECTED_ROLES
  callStartPermission     String                   @default("MEMBERS")      // OWNER_ONLY, ADMINS, MEMBERS

  // Temporary / Event communities
  isTemporary             Boolean                  @default(false)
  startDate               DateTime?
  endDate                 DateTime?
  archivedAt              DateTime?
  archiveReason           String?

  ownerId                 String
  owner                   User                     @relation("OwnedCommunities", fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  modules                 CommunityModule[]
  roles                   CommunityRole[]
  members                 CommunityMember[]
  channels                CommunityChannel[]
  invites                 CommunityInvite[]
  joinRequests            CommunityJoinRequest[]
  announcements           CommunityAnnouncement[]
  events                  CommunityEvent[]
  polls                   CommunityPoll[]
  files                   CommunityFile[]
  cryptoStates            CommunityCryptoState[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([ownerId])
  @@index([type])
}

model CommunityModule {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  moduleKey   String    // CHANNELS, ANNOUNCEMENTS, EVENTS, POLLS, FILES, CALLS, SPORTS_FIXTURES, PROJECTS
  isEnabled   Boolean   @default(true)
  settings    String?   // JSON configuration

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([communityId, moduleKey])
}

model CommunityRole {
  id                       String            @id @default(cuid())
  communityId              String
  community                Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name                     String
  icon                     String?
  color                    String?
  isSystem                 Boolean           @default(false)
  systemType               String?           // OWNER, ADMIN, MODERATOR, MANAGER, MEMBER, GUEST
  priority                 Int               @default(10)

  // Granular Permissions
  canSendMessages          Boolean           @default(true)
  canDeleteMessages        Boolean           @default(false)
  canAddMembers            Boolean           @default(false)
  canRemoveMembers         Boolean           @default(false)
  canInviteMembers         Boolean           @default(true)
  canCreateChannels        Boolean           @default(false)
  canManageCommunity       Boolean           @default(false)
  canCreateEvents          Boolean           @default(false)
  canManageEvents          Boolean           @default(false)
  canCreatePolls           Boolean           @default(true)
  canUploadFiles           Boolean           @default(true)
  canDeleteFiles           Boolean           @default(false)
  canStartCalls            Boolean           @default(true)
  canAssignRoles           Boolean           @default(false)
  canCreateAnnouncements   Boolean           @default(false)
  canModerateContent       Boolean           @default(false)
  canManageModules         Boolean           @default(false)

  members                  CommunityMember[]

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([communityId])
}

model CommunityMember {
  id           String         @id @default(cuid())
  communityId  String
  community    Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         CommunityRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  // Member details in this community
  nickname     String?
  title        String?
  department   String?
  teamNumber   Int?
  position     String?
  status       String         @default("ACTIVE") // ACTIVE, MUTED, BANNED
  
  invitedById  String?

  joinedAt     DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model CommunityChannel {
  id                 String                    @id @default(cuid())
  communityId        String
  community          Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  icon               String?
  type               String                    @default("PUBLIC") // PUBLIC, PRIVATE, ROLE_RESTRICTED
  allowedRoleIds     String?                   // JSON string array of role IDs if ROLE_RESTRICTED
  isAnnouncementOnly Boolean                   @default(false)

  messages           CommunityChannelMessage[]
  cryptoStates       CommunityCryptoState[]

  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([communityId])
}

model CommunityChannelMessage {
  id          String           @id @default(cuid())
  channelId   String
  channel     CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  // E2EE Encrypted Payload (Zero Plaintext on Server)
  ciphertext  String
  iv          String
  keyEpoch    Int              @default(1)
  
  // Metadata & Media
  type        String           @default("TEXT") // TEXT, MEDIA, POLL, EVENT, SYSTEM
  metadata    String?          // JSON metadata (e.g. encrypted media attachment info, dimensions)

  createdAt   DateTime         @default(now())

  @@index([channelId])
  @@index([senderId])
}

model CommunityInvite {
  id             String    @id @default(cuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  token          String    @unique
  assignedRoleId String?
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([communityId])
}

model CommunityJoinRequest {
  id              String    @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRoleId String?
  note            String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, BLOCKED
  reviewedById    String?
  reviewedAt      DateTime?

  createdAt       DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([communityId])
}

model CommunityAnnouncement {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  mediaUrl    String?
  isPinned    Boolean   @default(false)
  notifyAll   Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId])
}

model CommunityEvent {
  id          String               @id @default(cuid())
  communityId String
  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  
  rsvps       CommunityEventRsvp[]

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([communityId])
}

model CommunityEventRsvp {
  id        String         @id @default(cuid())
  eventId   String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String         @default("GOING") // GOING, MAYBE, NOT_GOING

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
}

model CommunityPoll {
  id          String                @id @default(cuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  question    String
  isMultiple  Boolean               @default(false)
  isAnonymous Boolean               @default(false)
  closesAt    DateTime?
  
  options     CommunityPollOption[]
  votes       CommunityPollVote[]

  createdAt   DateTime              @default(now())

  @@index([communityId])
}

model CommunityPollOption {
  id        String              @id @default(cuid())
  pollId    String
  poll      CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String

  votes     CommunityPollVote[]

  @@index([pollId])
}

model CommunityPollVote {
  id        String              @id @default(cuid())
  pollId    String
  poll      CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime            @default(now())

  @@unique([pollId, optionId, userId])
  @@index([pollId])
}

model CommunityFile {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  sizeBytes   Int
  mimeType    String
  fileUrl     String
  uploaderId  String

  createdAt   DateTime  @default(now())

  @@index([communityId])
}

model CommunityCryptoState {
  id                    String           @id @default(cuid())
  communityId           String
  community             Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelId             String
  channel               CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  keyEpoch              Int              @default(1)
  
  // Encrypted key envelopes for authorized member devices
  encryptedKeyEnvelopes String           // JSON mapping deviceId -> { ciphertext, iv }

  updatedAt             DateTime         @updatedAt

  @@unique([channelId, keyEpoch])
  @@index([communityId])
}


